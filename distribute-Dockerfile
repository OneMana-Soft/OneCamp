# A SUPPORTED BASE, WHICH IS ALL THIS IMAGE NEEDS TO BE.
#
# Nothing is compiled here. `app` is already built when the archive is made, so
# this image only has to run it, and the Go version has no effect on the binary
# the customer executes. That is worth stating because it is the opposite of what
# the tag suggests.
#
# It moved off 1.24, and then off 1.25, because Go supports the two most recent
# major releases, so an older base stops receiving updates entirely, including
# the Alpine packages underneath it. 1.26 matches the go directive in go.mod and
# is supported (helpers/dependencyAgeGuard_test.go holds the two together).
#
# The better fix is a plain alpine base: a runtime image has no business carrying
# a compiler and a module cache. That is a larger change than a security patch
# should carry, so it is noted rather than done.
FROM golang:1.26-alpine

RUN apk add --no-cache curl

WORKDIR /app

COPY . .

EXPOSE 3000

CMD [ "./app" ]