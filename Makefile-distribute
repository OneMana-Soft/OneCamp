	@echo "  make update REBUILD=1       rebuild the version already running"
	@echo ""
	@echo "Locked out of the workspace? Nobody can resend a password (we never"
	@echo "stored it), but you can issue a new one from the server:"
	@echo "  make reset-link EMAIL=admin@example.com"
