# Optional: the deployment env file. `-include` (not `include`) so the help
# target works before the operator has run `cp ./.sample.env ./.env`. Every
# target that needs a value still validates that the key is set and fails with
# a clear message rather than a missing-file error.
-include .env

# ═══════════════════════════════════════════════════════════════════════════════
# OneCamp — the Makefile a customer receives (shipped as `Makefile`).
#
# WHY MOST OF THIS IS NEW. The published install guide told customers to run
# update-admin-email, update-server-ip, replace-domain, create-traefik-password,
# update-traefik-email, update-allowed-domains and create-swap. NONE of those
# existed — not here, not in the development Makefile, nowhere in the
# repository. So a paying customer following the official instructions hit
# "No rule to make target" on the third line, having already been charged. They
# are implemented here because the documentation was the specification; the
# alternative was deleting seven steps from the guide and leaving the customer
# to hand-edit .env, which is what the guide was trying to avoid.
#
# Every target is idempotent and prints what it changed. A setup step that
# silently does nothing the second time you run it is indistinguishable from one
# that failed.
# ═══════════════════════════════════════════════════════════════════════════════

# Activating the optional local model engine has to be STICKY, not a flag on one
# command. Compose only manages the services in the profiles it is told about, so
# if `make ollama_up` passed --profile once, the very next `make build_restart_all`
# or `make down` would run without it and leave the engine running, unmanaged and
# invisible to every other target. Recording the choice in .env means every
# compose invocation below agrees about what this deployment consists of.
LOCAL_AI_PROFILE := $(if $(filter 1 true yes on,$(AI_LOCAL_MODELS)),--profile local-ai,)

# Serving the web app from this server is sticky the same way (SERVE_WEB in
# .env, set by `make install` for a self-hosted server, or `make web_up`).
WEB_PROFILE := $(if $(filter 1 true yes on,$(SERVE_WEB)),--profile web,)
# Virus scanning runs exactly when the API is told where to scan, so the two can
# never disagree: an install whose .env names CLAMAV_HOST keeps its scanner.
ANTIVIRUS_PROFILE := $(if $(strip $(CLAMAV_HOST)),--profile antivirus,)

# SELF is this makefile, for the targets that call each other.
#
# Plain $(MAKE) re-reads whatever make picks by default, which is this file only
# when it has been installed as "Makefile". Run it as `make -f Makefile-distribute`
# and every sub-make fails with "No rule to make target", which is how backup and
# restore both broke the first time either was run outside a customer install.
SELF := $(firstword $(MAKEFILE_LIST))

# STACK_FILE is resolved at run time rather than hardcoded.
#
# This was pinned to sample-compose.yml. When that file is not present — a
# source checkout rather than a release tarball, or a rename during packaging —
# docker compose still runs happily, matches no services, and every target
# reports "service postgres is not running" instead of failing. That is not a
# theoretical hazard: `make backup` took that path and wrote a 7-line archive
# containing none of the data, and reported success while doing it.
#
# Order is deliberate. sample-compose.yml stays FIRST so a working install keeps
# using exactly the file it uses today; the fallbacks only matter where the
# current code would otherwise have silently done nothing.
# The development stack (final-compose.yml, project onecamp-beta) is NOT listed.
# It differs by project name as well as filename, so it needs the full COMPOSE=
# override that demo-reset.sh already passes; listing the file alone would look
# like it worked and still match no running services.
# The trailing literal is the fallback when NONE of them exist, so the name is
# never empty. An empty -f argument makes docker compose match no services and
# every target then reports "service postgres is not running"; a name that is
# simply absent fails with "no such file", which is the honest error.
STACK_FILE := $(firstword $(wildcard sample-compose.yml compose.yml distribute-compose.yml) sample-compose.yml)

COMPOSE = docker compose --env-file .env --project-name onecamp $(LOCAL_AI_PROFILE) $(WEB_PROFILE) $(ANTIVIRUS_PROFILE) -f $(STACK_FILE)
IMAGE   = go_service_onecamp_onemana:1.0

.PHONY: install_run auto-domain-https coding-up coding-smoke coding-down help setup update-admin-email update-server-ip replace-domain \
        create-traefik-password update-traefik-email update-allowed-domains \
        create-swap configure-livekit create_postgres_db migrate_up migrate_status \
        build_restart_all build_restart_service console-tunnel doctor verify logs \
        set-flat-domains secrets install \
        reset-link reset-password clear-2fa change-email update \
        ollama_up ollama_down ollama_update saml-cert

