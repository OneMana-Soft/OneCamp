	@echo "  make secrets                generate every credential the install can choose itself"
	@echo "  make setup EMAIL=you@example.com DOMAIN=example.com PASSWORD=<traefik-admin-pw>"
	@echo "     runs every configuration step below in the right order"
	@echo ""
	@echo "Individual steps:"
	@echo "  make update-admin-email EMAIL=you@example.com"
	@echo "  make restart-api                                 (after editing .env)"
	@echo "  make update-server-ip"
	@echo "  make replace-domain DOMAIN=example.com          (your own domain)"
	@echo "  make set-flat-domains SLUG=acme ZONE=onemana.dev (a managed subdomain)"
	@echo "  make create-traefik-password PASSWORD=<pw>"
	@echo "  make update-traefik-email EMAIL=you@example.com"
	@echo "  make update-allowed-domains DOMAINS=example.com"
	@echo "  make create-swap"
	@echo "  make configure-livekit    writes livekit.yaml from your .env"
	@echo "  make saml-cert            makes SAML sign-in's certificate and key (licence)"
	@echo ""
	@echo "Then bring it up:"
	@echo "  make build_restart_all      build the image and start everything"
	@echo "  make create_postgres_db     create the database (first install only)"
	@echo "  make migrate_up             apply the schema"
	@echo ""
	@echo "Operations:"
	@echo "  make doctor                 check .env for unset placeholders"
	@echo "  make migrate_status         what the database believes is applied"
	@echo "  make console-tunnel         reach the admin consoles safely"
	@echo "  make verify                 check a finished install is actually working"
	@echo "  make logs SERVICE=go-service  a service's recent log (web, traefik, ...; LINES=500 for more)"
	@echo "  make journey                prove the product works: creates a task, reads it back"
