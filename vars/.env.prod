PORT=3000
DSN="host=postgres port=5432 user=root password=__CHANGE_ME_STRONG_DB_PASSWORD__ dbname=onecamp sslmode=disable timezone=UTC connect_timeout=5"
DB_PASSWORD=__CHANGE_ME_STRONG_DB_PASSWORD__
DB_HOST=postgres
DB_PORT=5432
DB_USER=root
DB_NAME=onecamp
REDIS_PASSWORD=__CHANGE_ME_STRONG_REDIS_PASSWORD__
REDIS_HOST=redis:6379
JWT_SECRET=__CHANGE_ME_RANDOM_64_CHARS__
MINIO_USER=root
MINIO_PASSWORD=__CHANGE_ME_STRONG_MINIO_PASSWORD__
MINIO_ACCESS_KEY_ID=dfasd
MINIO_SECRET_ACCESS_KEY=__CHANGE_ME_RANDOM_40_CHARS__
MINIO_HOST=__CHANGE_ME_RUN_make_replace-domain__
MINIO_SSL=true
USER_UPLOAD_BUCKET_NAME=onecamp-uploads
DGRAPH_HOST=alpha:9080
DGRAPH_USER=groot
DGRAPH_PASSWORD=__CHANGE_ME_STRONG_DGRAPH_PASSWORD__
EMQX_DASHBOARD_DEFAULT_USERNAME=onemana
EMQX_DASHBOARD_DEFAULT_PASSWORD=__CHANGE_ME_STRONG_EMQX_PASSWORD__
MQTT_CLEAN_SESSION=true
MQTT_BROKER=tcp://emqx:1883
# Public WebSocket URL served to clients for real-time messaging (chat,
# typing, presence). REQUIRED — there is no fallback in code, so an empty
# value breaks real-time. Must match EMQX_WS_DOMAIN below, over wss, /mqtt path.
MQTT_WS_URL=wss://__CHANGE_ME_RUN_make_replace-domain__/mqtt
MQTT_CLIENT_ID=backend
MQTT_USERNAME=backend
OS_HOST=https://opensearch-node1:9200
OS_PASSWORD=__CHANGE_ME_STRONG_OPENSEARCH_PASSWORD__
OS_USERNAME=admin
# Search engine version, for BOTH the node and Dashboards. One knob on purpose:
# OpenSearch requires Dashboards to match the node, and a variable that moved one
# without the other would be the breakage rather than the control.
# Pinned, never `latest`: a search cluster that comes back on a different version
# can refuse to open an index written by the previous one.
OPENSEARCH_VERSION=3.6.0
GOOGLE_CLIENT_ID=38103784422-0gnuoqjuk3crpqgvqncpieqr8i.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=__CHANGE_ME_YOUR_OWN_GOOGLE_OAUTH_SECRET__
GITHUB_CLIENT_ID=0316519eb0fba6d68
GITHUB_CLIENT_SECRET=__CHANGE_ME_YOUR_OWN_GITHUB_OAUTH_SECRET__
# NO CONSOLE HOSTNAMES. MINO_CONSOLE_DOMAIN, OS_DOMAIN and EMQX_CONSOLE_DOMAIN are
# deliberately absent. The MinIO console, OpenSearch Dashboards and the EMQX dashboard
# are not routed through Traefik any more, so a hostname for them would point at
# something that does not answer. Reach them with `make console-tunnel`.
MQTT_DOMAIN=__CHANGE_ME_RUN_make_replace-domain__
MINO_DOMAIN=__CHANGE_ME_RUN_make_replace-domain__
# POSTGRES_DOMAIN and REDIS_DOMAIN are gone. They named the public hostnames the
# database and the cache were routed on, through Traefik TCP routers that put both on
# the internet behind only a password. The routers, the entrypoints and the published
# ports are all removed; `make migrate_up` reaches Postgres on the internal network.
BACKEND_DOMAIN=__CHANGE_ME_RUN_make_replace-domain__
EMQX_WS_DOMAIN=__CHANGE_ME_RUN_make_replace-domain__
FE_DOMAIN=__CHANGE_ME_RUN_make_replace-domain__
FIREBASE_CRED_PATH=firebase-cred.json
ADMIN_EMAIL_ID=__CHANGE_ME_RUN_make_update-admin-email__
UPLOAD_LIMIT_IN_MB=10

# ─── Anti-virus scanning for user uploads (ClamAV) ───────────────────
# When CLAMAV_HOST is set, every upload (chat/import attachments, avatars,
# email logo) is streamed to clamd (INSTREAM, TCP) before the MinIO write
# commits; an infected file is rejected and rolled back. Leave CLAMAV_HOST
# UNSET to disable scanning. final-compose.yml ships a `clamav` service.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Per-file dial+scan timeout (seconds). Default 60.
# CLAMAV_SCAN_TIMEOUT_SECONDS=60
# Max bytes scanned per file. Files larger than this are NOT asserted clean
# (verdict=unknown → AVSCAN_FAIL_OPEN decides). Default 1 GB (1073741824).
# CLAMAV_MAX_BYTES=1073741824
# On scanner error/outage: true = allow the upload (fail-open, default);
# false = reject the upload (fail-closed). Virus MATCHES are always rejected.
AVSCAN_FAIL_OPEN=true
TRAEFIK_EMAIL=__CHANGE_ME_RUN_make_update-traefik-email__
TRAEFIK_DOMAIN=__CHANGE_ME_RUN_make_replace-domain__
TRAEFIK_HASHED_PASSWORD=__CHANGE_ME_BCRYPT_HASH_FROM_HTPASSWD__
# NOTE: ALLOWED_DOMAINS is NOT read by the backend (dead config; access is
# gated by ALLOWED_USERS + the invitations table — see business/User). Kept
# only because provisioning templates reference it. Safe to ignore/remove.
ALLOWED_DOMAINS=__CHANGE_ME_RUN_make_update-allowed-domains__

# Shared internal-service secret. REQUIRED: must match INTERNAL_SECRET on the
# LiveKit transcription agent / hocuspocus so their server-to-server posts
# (e.g. /livekit/transcript) are accepted. An unset value denies all internal
# requests. Generate with: openssl rand -base64 32
INTERNAL_SECRET=__SET_FROM_SECRET_STORE__

# Allow-list for first-time OAuth sign-ups (comma-separated emails). A new
# user must be in this list OR have a pending invitation, else login is
# rejected with "user not allowed". Leave empty for invite-only.
ALLOWED_USERS=

# LiveKit (calls / meetings). REQUIRED for audio/video. HostURL is the
# in-cluster server URL; API key name + secret must match the LiveKit server
# and the egress/transcription agents (LIVEKIT_API_KEY_NAME / LIVEKIT_API_PASS).
LIVEKIT_HOST=http://livekit:7880
LIVEKIT_DOMAIN=__CHANGE_ME_RUN_make_replace-domain__
LIVEKIT_API_KEY_NAME=onecamp
LIVEKIT_API_PASS=__SET_FROM_SECRET_STORE__
LIVEKIT_API_KEY=__CHANGE_ME_SEE_LIVEKIT_API_KEY_NAME_AND_PASS__
TURN_SECRET=__SET_FROM_SECRET_STORE__
TURN_DOMAIN=__CHANGE_ME_RUN_make_replace-domain__

# Call transcription (LiveKit agent). "frontend" uses the browser Web Speech
# path; "backend" runs server-side STT via the Python agent.
#
# NOTE: These are now ENV FALLBACKS only. The effective transcription config
# (mode, STT provider/model/endpoint/language, keys) is admin-managed at
# runtime under Admin → Settings → Call transcription and stored in the DB
# (secrets encrypted). The DB value wins; these env vars apply only until an
# admin saves a value. The agent fetches the resolved config from the backend
# at room-join (GET /livekit/transcription-config, internal-secret gated).
#
# STT is model-agnostic: provider ∈ deepgram | google | openai. The "openai"
# kind + STT_BASE_URL targets any OpenAI-compatible endpoint (OpenAI Whisper,
# Groq, a self-hosted faster-whisper / vLLM server) — plug-and-play, no code
# change.
TRANSCRIPTION_MODE=frontend
STT_PROVIDER=deepgram
STT_MODEL=
STT_BASE_URL=
STT_LANGUAGE=
DEEPGRAM_API_KEY=""
# OPENAI_API_KEY is deliberately NOT redeclared here.
#
# It used to be, and the duplicate was worse than useless: the same variable is
# declared again in the AI-provider section below, so the later line won and
# silently blanked whatever was set here. An operator configuring OpenAI as their
# speech-to-text provider would set this one, restart, and find it had no effect,
# with nothing to indicate why. One OpenAI key, one declaration — the AI section.
GOOGLE_APPLICATION_CREDENTIALS=""

# Transactional email (Resend API). When unset, the ENTIRE email subsystem
# is a silent no-op: invitations, password reset, and notification digests
# are all skipped. Set this to a valid Resend API key to enable email.
# Get one at https://resend.com
# REQUIRED for production password-reset and invitation flows.
RESEND_API_KEY=__SET_FROM_SECRET_STORE__

# Bootstrap admin password for the seeded admin account.
ADMIN_PASSWORD=__SET_FROM_SECRET_STORE__

# Demo Login (set DEMO_MODE=true to enable guest demo access).
DEMO_MODE=false
DEMO_USER_EMAIL=
DEMO_USER_NAME=Demo User

FE_HOST_DOMAIN=__CHANGE_ME_RUN_make_replace-domain__

# GitHub Integration (for linking repos, syncing issues/PRs)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Slack Import — see business/SlackImport for the pipeline.
# ─────────────────────────────────────────────────────────────────────
# Production: bigger workspaces, more concurrency. Tune with the
# go-service deploy resources in distribute-compose.yml; rule of thumb
# is one msg worker per available CPU core, file workers ~half that.
SLACK_IMPORT_MSG_WORKERS=4
SLACK_IMPORT_FILE_WORKERS=2

# 50 GB cap covers Corporate (Plus/Enterprise) exports for the largest
# customers. Files over 2 GB are uploaded browser→MinIO directly via
# presigned PUT (see HandlePresignUpload), so there is no /tmp staging
# dependency at any size. The cap exists purely to prevent denial-of-disk
# on MinIO. 50 GB = 53687091200
EXPORT_MAX_BYTES=53687091200


# Production retention. 7 days gives operators a generous window to
# decide if a failed import should be retried before the staged ZIP is
# garbage-collected from MinIO. Storage cost is the trade-off; on the
# go-service-host MinIO defaults this is ~50 GB max per concurrent job.
SLACK_IMPORT_RAW_RETENTION_DAYS=7

# 24 hours covers a slow transcontinental presigned-PUT upload that
# never finalised. Abandoned uploads are auto-failed and reaped here.
SLACK_IMPORT_PENDING_TTL_HOURS=24

# Kill-switch: when set to "1" the orchestrator falls back to the
# legacy path that downloads the entire export ZIP to /tmp before
# parsing. Default "0" uses HTTP range requests against MinIO and
# scales to arbitrarily large exports without touching local disk.
# Toggle this only if your S3 layer's range-request behaviour breaks
# with the default path.
SLACK_IMPORT_STAGE_TO_DISK=0


# ════════════════════════════════════════════════════════════════════
# Generic Import pipeline (Trello / Asana / Jira / Notion / Todoist)
# ════════════════════════════════════════════════════════════════════
#
# Production tunables for the provider-agnostic pipeline. Workspace
# imports tend to be I/O-bound on the source provider's API limits
# rather than CPU, so worker counts can be modest.

# Worker pool sizes per stage. Production matches the Slack pipeline
# (4 task workers, 2 attachment workers). Bump alongside go-service
# deploy resources in distribute-compose.yml.
IMPORT_TASK_WORKERS=4
IMPORT_COMMENT_WORKERS=4
IMPORT_ATTACHMENT_WORKERS=2

# Same retention as Slack: 7 days lets operators retry a failed import
# before the staged source file is reaped from MinIO.
IMPORT_RAW_RETENTION_DAYS=7

# 24 hours covers a slow transcontinental presigned-PUT upload of a
# Notion ZIP or Jira backup that never finalised.
IMPORT_PENDING_TTL_HOURS=24

# 50 GB cap on staged source files. Trello board JSON exports are
# small (<10 MB even for huge boards), but Notion workspace ZIPs and
# Jira XML backups can run into tens of GB. Live-API providers ignore
# this cap. 50 GB = 53687091200
IMPORT_MAX_BYTES=53687091200

# Key-encryption key for at-rest encryption of OAuth tokens.
# REQUIRED in production. Read from the platform secret store; never
# commit a real value. The string below is a placeholder — replace
# during deploy. Rotation procedure documented in .env.
#
# Generate with:  openssl rand -base64 48
IMPORT_TOKEN_KEK=__SET_FROM_SECRET_STORE__

# Key-encryption key for AI provider credentials and MCP server secrets.
# REQUIRED in production even when AI features are disabled: the boot-time
# KEK validator still checks it round-trips. Read from the platform secret
# store; never commit a real value.
AI_CONFIG_KEK=__SET_FROM_SECRET_STORE__

# ════════════════════════════════════════════════════════════════════
# AI Second Brain — model-agnostic (admin-managed via the admin panel)
# ════════════════════════════════════════════════════════════════════
#
# These env vars are the BOOT FALLBACK / defaults. Once an admin sets a
# provider+model in the admin panel, the DB (ai_settings + ai_providers,
# migration 64) is the source of truth and is hot-reloaded at runtime.
# Optional: daily AI token budgets (enforced at the provider layer, so they
# cover EVERY AI feature — assistant chat, Board AI, agents, tables, workflows).
# Both default to 0 = unlimited. A call is refused when EITHER cap is reached;
# the meters reset at 00:00 UTC. Best-effort (a Redis outage never blocks AI).
#   AI_WORKSPACE_DAILY_TOKEN_BUDGET  total tokens/day across the workspace.
#   AI_USER_DAILY_TOKEN_BUDGET       tokens/day per individual user.
# AI_WORKSPACE_DAILY_TOKEN_BUDGET=0
# AI_USER_DAILY_TOKEN_BUDGET=0
# Optional per-agent-run safety limits (background agent loop only):
#   AI_AGENT_MAX_RUN_TOKENS      stop a single run after N tokens (default 80000).
#   AI_AGENT_RUN_TIMEOUT_SECONDS wall-clock deadline for a run (default 300).
# AI_AGENT_MAX_RUN_TOKENS=80000
# AI_AGENT_RUN_TIMEOUT_SECONDS=300
# Optional: how an agent's channel/thread @mention is executed.
# A durable run is the only kind a person can stop, correct mid-run, or watch, so
# a mention is durable whenever the agent has tools to use (a conversation-only
# agent stays synchronous — there is nothing to stop). An agent can also opt in
# explicitly in the builder ("run in background").
#   AI_AGENT_DURABLE_MENTIONS   false reverts to the old synchronous mentions.
#   AI_AGENT_ACK_DELAY_SECONDS  how long a run may take before it posts "On it"
#                               (default 4). The ack is cancelled by the real
#                               answer, so fast work posts one comment, not two.
#                               0 acknowledges immediately.
# AI_AGENT_DURABLE_MENTIONS=true
# AI_AGENT_ACK_DELAY_SECONDS=4

# Optional: agent-to-agent delegation ("Slack for agents").
#
# Until this existed an agent's message could not reach another agent at all: every
# botpost write deliberately emits no post.created event, and the mention
# dispatcher runs off that event. That blanket mute is a safe loop guard for one
# agent and the exact thing blocking collaboration, so it is replaced by a BUDGET
# rather than removed.
#
# Every hop carries the originating PERSON, so an agent action always traces to
# someone who could have taken it themselves; a chain with no human at its root is
# refused. Cycles are refused by identity, not just by depth, because two agents
# mentioning each other would otherwise ping-pong forever while each side saw
# itself as starting fresh.
#
# These are now ADMIN settings (Settings -> AI), stored in ai_settings and
# hot-reloaded. The env vars below remain, with reduced roles:
#
#   AI_AGENT_DELEGATION           a KILL SWITCH, not a switch. Only false/0/no/off
#                                 has any effect: it VETOES delegation regardless
#                                 of the admin setting, so infrastructure can forbid
#                                 what the UI would otherwise allow. Absent means
#                                 "no opinion, let the admin decide" — it can never
#                                 turn delegation ON.
#   AI_AGENT_DELEGATION_CHANNELS  where collaboration is permitted: a comma-
#                                 separated list of SURFACE keys, or * for all.
#                                 A channel is its bare uuid; a task is
#                                 "task:<uuid>" — both surfaces matter because a
#                                 tagged agent answers in a channel THREAD while an
#                                 agent assigned a task answers in a task COMMENT.
#                                 The two id spaces are prefixed apart so a task
#                                 can never be opted in by naming a channel that
#                                 happens to share its uuid. Ids are validated, so
#                                 a typo opts nothing in rather than half-matching.
#                                 Empty means nowhere. Used only as a BOOTSTRAP
#                                 while the admin list is empty; once an admin names
#                                 a surface, that list is authoritative and this is
#                                 no longer consulted, so there is never a question
#                                 of which one is in force.
#   AI_AGENT_DELEGATION_MAX_HOPS  fallback only, for when the admin value is unset.
#                                 Default 2, covering human -> triage -> coder. A bad
#                                 value falls back to the default rather than to 0,
#                                 so a typo cannot silently disable what you enabled.
#
# PERMISSIONS. An agent runs as its own owner, so delegation could otherwise
# launder authority: a limited member mentions an agent owned by an admin, whose
# reply mentions a second agent owned by another admin, and a chain the member
# started executes with rights they never had. The invariant enforced is that a
# delegated run may never reach an agent the ORIGINATING PERSON could not have
# addressed themselves — checked against the same channel-visibility query used
# for entity-scoped agent work, and denied for anything it cannot verify. The run
# is also attributed to that person rather than to the relaying bot, so the audit
# trail names someone accountable.
# AI_AGENT_DELEGATION=false
# AI_AGENT_DELEGATION_CHANNELS=
# AI_AGENT_DELEGATION_MAX_HOPS=2
# Optional: how many READ-ONLY tool lookups one agent step may run at the same
# time. A model often asks for several independent reads in one turn, and running
# them serially made a step cost the sum of every round trip. Writes are never
# parallelised. Default 4; set to 1 to disable the fast path entirely.
# AI_AGENT_PARALLEL_READS=4
# Optional: conversation compaction (long tool-loops). When a run's prompt
# approaches the model's usable window, older turns are folded into a summary
# (plus mechanically extracted working state and the human's own messages) so
# the run keeps going instead of losing its system prompt to front-truncation
# or dying on a provider "context length exceeded". On by default; these only
# tune it.
#   AI_CONTEXT_COMPACT_THRESHOLD_PCT  share of the usable input budget that
#                                     triggers a fold, 0<pct<=1 (default 0.75).
#   AI_CONTEXT_COMPACT_CAP_TOKENS     absolute trigger ceiling, so a huge-window
#                                     model still folds early (default 250000).
#   AI_CONTEXT_COMPACT_SUMMARY_TOKENS summary output ceiling (default: scaled to
#                                     the window, 256–1500).
# AI_CONTEXT_COMPACT_THRESHOLD_PCT=0.75
# AI_CONTEXT_COMPACT_CAP_TOKENS=250000
# AI_CONTEXT_COMPACT_SUMMARY_TOKENS=0
# Optional: best-effort USD cost estimate for local/unknown models, per 1k tokens.
# AI_DEFAULT_INPUT_PRICE_PER_1K=0
# AI_DEFAULT_OUTPUT_PRICE_PER_1K=0


# Ollama (default — self-hosted, free). OLLAMA_HOST is also used to build
# the built-in Ollama provider's base URL when its DB base_url is empty.
# Shared token between the server and the OPTIONAL code-execution sandbox.
#
# Leave it EMPTY unless you enable the sandbox. It used to be required of everyone,
# because the compose file marked it ${CODE_RUNNER_TOKEN:?...} and Compose evaluates
# interpolation for the whole file whatever profiles are active — so an operator who
# would never run the sandbox still had to invent a secret for it before anything would
# start. The marker is gone; the sandbox service checks the token itself and refuses to
# start without one, which is the only place that can tell whether it matters.
#
# To enable it: generate a value here (openssl rand -base64 32), set the same value in
# ai_settings.sandbox_runner_token, then start the "code-execution" profile.
CODE_RUNNER_TOKEN=
# The Ollama engine version this deployment runs. Pinned, never `latest`: the
# admin panel reports the running version against the newest release and offers
# an update, and both are meaningless if the tag can move on its own.
# To update: set this to the target version, then `make ollama_update`. To roll
# back: set the previous value and run it again. Published tags are listed at
# hub.docker.com/r/ollama/ollama/tags — use the plain version, no leading "v".
# Model context window passed to Ollama as num_ctx. BOOT FALLBACK only:
# once an admin sets "Context window" in the AI panel, ai_settings is the
# source of truth and hot-reloads (it drives BOTH num_ctx and the prompt
# token budget, so they never diverge). Default 8192, floor 2048.
# OLLAMA_NUM_CTX=8192
# Optional: override the prompt token budget's window independently of
# OLLAMA_NUM_CTX (e.g. a cloud chat model with a larger window). Also a
# boot fallback for the admin setting.
# AI_CONTEXT_TOKENS=8192

# OpenAI / Anthropic boot fallbacks (admin panel overrides these).
OPENAI_API_KEY=
# ─── Key-encryption keys ─────────────────────────────────────────────
# All three are set from the secret store in one go. Grouped here because
# that is how an operator actually handles them, and because the server
# now REFUSES TO START while any of them is still the placeholder below.
#
# That refusal is not belt-and-braces. The previous checks asked only "is
# it empty?" and "is it the dev fallback?", so this exact unsubstituted
# string was accepted as a real key — beta ran for months encrypting every
# provider key, MCP auth secret and OAuth import token with a value
# committed to this repository. A weak key does not announce itself; it
# works perfectly. See helpers/kek.go.
#
# Generate each one separately: openssl rand -base64 48
#
# CHANGING ANY OF THEM LATER CANNOT BE UNDONE. Anything already sealed
# under the old value becomes undecryptable and must be re-entered. There
# is no re-encryption path.

# Marks this as a real deployment rather than a local checkout. The
# UNSET-key branches of the KEK probes only fire when this says production.
APP_ENV=production

# AI provider API keys in the admin panel (ai_providers.api_key_enc), and
# MCP server auth secrets. AES-256-GCM, SHA-256-derived.
# TOTP two-factor secrets (migration 141).
#
# SEPARATE FROM AI_CONFIG_KEK ON PURPOSE: that key is rotated when a
# provider credential leaks, and sharing it would mean an unrelated
# rotation locks every enrolled user out of their own account.
#
# UNSET IS A SUPPORTED CONFIGURATION and simply means this deployment does
# not offer two-factor authentication — enrolment refuses with an
# actionable message rather than sealing secrets under a built-in default.
#
# SET IT BEFORE ANYONE ENROLS. Changing it afterwards makes every enrolled
# secret undecryptable and each affected user needs an administrator reset.
TOTP_KEK=__SET_FROM_SECRET_STORE__
# Optional: filesystem path the admin AI panel reports free space for
# (defaults to "/"). final-compose mounts the host's ./data/ollama into
# go-service read-only at /ai-model-disk, so set this to that mount to get
# an exact "will this model fit" reading on the disk where models land.
# AI_DISK_PATH=/ai-model-disk
# Optional: embedding-reindex worker concurrency (default 4).
# AI_REINDEX_CONCURRENCY=4
# Optional: hosted JSON manifest URL for the admin "browse & install" Ollama
# model catalog. Keeps the curated list current with newly-published models
# WITHOUT a redeploy — edit the hosted JSON, every instance refreshes within
# ~1h (cache TTL) or via the panel's "refresh catalog" action. Merged over the
# embedded baseline (remote overrides/extends by tag; baseline never shrinks).
# Must be https. Empty = embedded list only (offline/air-gapped safe).
# Installing never depends on this — any tag can be pulled manually.
# AI_OLLAMA_CATALOG_URL=
# Optional SSRF policy for admin-added custom AI endpoints. Default (unset)
# allows private/LAN/cluster IPs so internal model servers (Ollama, vLLM)
# on the same host/VPC work — the correct default for self-hosting. Set
# true to additionally block loopback + RFC1918 + ULA when you want to stop
# a workspace admin from probing the host's private network via a custom
# endpoint (cloud-metadata/link-local are blocked regardless).
# AI_BLOCK_PRIVATE_IPS=false
# Destination policy for external DATA SOURCES (the read-only SQL connections
# an agent can query). Configuring one is agent.manage gated, and agent.manage
# is delegable to members, so the reachable set is constrained by default:
#   * link-local / cloud instance metadata / multicast / unspecified are ALWAYS
#     refused and cannot be enabled here;
#   * loopback and private (RFC1918 / IPv6-ULA / CGNAT) are refused UNLESS
#     listed below — set this when the database really is internal;
#   * public hosts are allowed when this is empty; once it is set it is
#     EXHAUSTIVE (every data source host must match it).
# Comma-separated; each entry may be an exact hostname, an exact IP, or a CIDR.
# Hostnames are resolved and every returned address is checked, and the check
# runs again at connect time (so a DNS answer cannot flip to a blocked address).
# Example: AI_DATASOURCE_HOST_ALLOWLIST=analytics-db.internal,10.20.0.0/16,203.0.113.7
# AI_DATASOURCE_HOST_ALLOWLIST=
#
# ─── AI agent governance + coding overrides (all optional) ───────────────────
# These are BOOT-TIME escape hatches for deployments that never open the admin
# UI. Where an admin setting exists it is the source of truth; the variable
# applies only when the setting is unset. Left unset, every default below is the
# safe one — so an install that ignores this whole block is correctly governed.
#
# Which branches an agent may NEVER write to directly through an MCP git tool
# (it must create a branch and open a PR instead). Comma-separated; defaults to
# main + master when unset. Case-insensitive. An omitted branch argument means
# the repo's default branch and is always protected.
# Example: AI_PROTECTED_BRANCHES=main,master,release
# AI_PROTECTED_BRANCHES=
#
# DANGER: setting this to true DISABLES the protected-branch guard entirely, so
# an agent can commit straight to your default branch with no pull request and
# no review. There is no legitimate production reason to set it. Left unset (the
# default) the guard is on.
# AI_ALLOW_AGENT_DEFAULT_BRANCH_WRITE=
#
# Extra tool-name keywords to treat as DESTRUCTIVE, for custom MCP tools whose
# names our built-in verb list doesn't recognize. A destructive tool is never
# run unattended and always carries a warning. Additive: the built-ins (delete,
# drop, purge, truncate, …) always apply. Comma-separated, matched per whole
# name token, so this cannot accidentally widen to unrelated tools.
# Example: AI_DESTRUCTIVE_TOOL_KEYWORDS=rotate,deprovision
# AI_DESTRUCTIVE_TOOL_KEYWORDS=
#
# How long ONE code-PR coding run may work, in minutes. The admin setting
# (AI settings → Code PR → coding time limit) is the source of truth; this
# applies only while that is 0/unset. Clamped to 2..60; unset = 30. Raising it
# automatically widens the derived deadlines (durable-queue lease, sidecar write
# timeout), so this is the ONE number to change — never restate it elsewhere.
# AI_CODE_PR_WALL_MINUTES=
#
# Whether an agent may open a PR on ANY repository the connected GitHub account
# can reach, rather than only repositories linked to a project. The admin
# setting owns this; the variable overrides it at boot. Default (unset) is
# linked-only — the blast-radius-safe choice for a shared install.
# AI_CODE_PR_ALLOW_UNLINKED=
#
# Where the coding sidecar calls back for model completions. An INTERNAL,
# in-cluster address, never public. Unset uses the address every shipped compose
# file already provides, so the standard deployment needs nothing here.
# AI_CODE_PR_LLM_PROXY_URL=
#
# How long a claimed durable agent task stays leased before another worker may
# treat it as crashed and reclaim it, in seconds. Derived automatically from the
# longest run the worker dispatches plus margin, and a live run heartbeats its
# lease, so this only changes how quickly a job recovers from a DEAD worker.
# It can only ever LENGTHEN the lease past that derived floor: a value below it
# is ignored, because a lease shorter than the work it guards is the bug.
# AI_AGENT_TASK_LEASE_SECONDS=

# Optional: batched workspace-memory extraction worker tuning. Inert until
# an admin enables the memory layer; then it periodically extracts
# decisions/commitments/open-questions from changed channels, DMs/groups,
# and project threads.
#   AI_MEMORY_INTERVAL_MIN  sweep cadence in minutes (default 60, floor 5).
#   AI_MEMORY_LOOKBACK_HRS  active-scope discovery window in hours
#                           (default 168 = 7d, floor 1).
# AI_MEMORY_INTERVAL_MIN=60
# AI_MEMORY_LOOKBACK_HRS=168
# Optional: "rebuild memory" backfill lookback in days (default 180, cap 1095).
# AI_MEMORY_BACKFILL_DAYS=180
# Optional: proactive memory-digest send hour, local 0-23 (default 8). Honors
# each user's digest frequency (off/daily/weekly); weekly sends on Mondays.
# AI_MEMORY_DIGEST_HOUR=8
# Optional: weekly team-report post hour, local 0-23 (default 9, Mondays).
# Gated by the admin Team Report toggle (requires Workspace Memory).
# AI_TEAM_REPORT_HOUR=9

# Set by `make tune` from the machine (a quarter of RAM for search, 720p
# recordings on four cores or fewer). Set TUNE_MANUAL=1 to keep your own values.
OPENSEARCH_HEAP=512m
EGRESS_PRESET=1080p30
