{
  "name": "@onecamp/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the OneCamp public API (/v1). Scoped API tokens, tasks, projects, messages, and tables.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "onecamp",
    "sdk",
    "api",
    "tasks",
    "tables",
    "mcp"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
